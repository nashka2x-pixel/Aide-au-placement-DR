margin-left:36px}
.numpad {
right:8px;
bottom:8px;
width:min(300px,calc(100vw - 16px))}
}
  </style>
</head>
<body>
<header>
<div class="topbar">
<h1>📦 Inventaire — Bundles</h1>
<div class="actions">
<span id="catalogStatus" class="muted">
</span>
