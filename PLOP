color:#3726b0}
.count {
background:#f0f7ff;
color:#0b74ff}
.dirty {
background:#fff3cd;
color:#856404}
.cloud {
background:#e9f3ff;
color:#0759a7}
.pending {
background:#ffe8cc;
color:#9a5c00}
.ready {
background:#dffae3;
color:#0b6b2f}
.conflict {
background:#ffe0e0;
color:#a30000}
.save-btn {
background:#198754}
.save-btn.dirty {
background:#e38800}
.spacer {
flex:1}
    #bundleTableWrap,#bundleSearchResults {
width:100%;
overflow-x:auto}
.inventory-table,.search-table {
width:100%;
border-collapse:collapse;
background:#fff;
table-layout:auto}
.inventory-table th,.inventory-table td,.search-table th,.search-table td {
