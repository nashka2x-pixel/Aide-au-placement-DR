</div>
<div id="listEmpty" class="muted">Aucun bundle pour l’instant.</div>
<div id="bundlesList" class="bundle-list">
</div>
</section>
<section id="sectionBundle" class="hidden">
<div class="toolbar">
<button id="btnBack" class="secondary">← Retour</button>
<strong id="bundleTitle">
</strong>
<span id="bundleMeta" class="muted">
</span>
<span class="spacer">
</span>
<span id="bundleSaveStatus" class="muted">
</span>
<button id="btnForceBundle" class="save-btn" style="display:none">
  ⚠️ Forcer ma version
</button>
<button id="btnSaveBundle" class="save-btn">💾 Sauvegarder</button>
</div>
<div id="numPadOverlay" class="numpad-overlay" aria-hidden="true">
<div class="numpad">
<div id="numPadDisplay" class="numpad-display">0</div>
<div class="numpad-grid">
<button type="button" class="numpad-key" data-num="1">1</button>
<button type="button" class="numpad-key" data-num="2">2</button>
<button type="button" class="numpad-key" data-num="3">3</button>
<button type="button" class="numpad-key" data-num="4">4</button>
<button type="button" class="numpad-key" data-num="5">5</button>
<button type="button" class="numpad-key" data-num="6">6</button>
<button type="button" class="numpad-key" data-num="7">7</button>
<button type="button" class="numpad-key" data-num="8">8</button>
<button type="button" class="numpad-key" data-num="9">9</button>
<button type="button" class="numpad-key" data-op="-">-</button>
<button type="button" class="numpad-key" data-num="0">0</button>
<button type="button" class="numpad-key" data-op="+">+</button>
<button type="button" class="numpad-key" data-op="*">*</button>
<button id="numPadBackspace" type="button" class="numpad-key">⌫</button>
<button id="numPadClear" type="button" class="numpad-key clear">C</button>
</div>
<button id="numPadValidate" type="button" class="numpad-valid">✓</button>
</div>
</div>
<div class="card">
<h3>📥 Ajouter des articles / 🔎 Rechercher</h3>
<div class="row">
<div>
<label>Code Barre</label>
<br>
<input id="s_cb" placeholder="Scan / saisie">
</div>
<div>
<label>Code IREC</label>
<br>
<input id="s_irec" placeholder="IREC-001234">
</div>
<div>
<label>Intitulé</label>
<br>
<input id="s_int" placeholder="Ex. Mug volcan">
</div>
<button id="btnClearSearch" class="secondary">✖</button>
</div>
<div id="bundleSearchMsg" class="muted">
</div>
<div id="bundleSearchResults">
</div>
</div>
<div class="card">
<h3>📦 Articles du bundle</h3>
<div id="bundleMsg" class="notice hidden">
</div>
<div id="bundleTableWrap">
</div>
<div id="bundleFooter" class="toolbar">
</div>
</div>
</section>
</div>
<script>
const $=id=>document.getElementById(id),show=el=>el&&el.classList.remove('hidden'),hide=el=>el&&el.classList.add('hidden');
const BUNDLES_KEY='bundles_v3',TEAM_NAME_KEY='inv_team_name',DEVICE_ID_KEY='inv_device_id';let spaces=[],currentBundleId=null,timer=null,highlightedRowNumber=null;
function load(){try{const v=JSON.parse(localStorage.getItem(BUNDLES_KEY)||'[]');return Array.isArray(v)?v:[]}catch(e){return[]}}function save(v){localStorage.setItem(BUNDLES_KEY,JSON.stringify(v))}function getBundle(id){return load().find(x=>x.id===id)}function uuid(){return'b_'+Math.random().toString(36).slice(2)+Date.now().toString(36)}function mutate(id,fn){const a=load(),b=a.find(x=>x.id===id);if(!b)return null;fn(b);save(a);return b}function deleteBundle(id){save(load().filter(x=>x.id!==id))}function getDeviceId(){let id=localStorage.getItem(DEVICE_ID_KEY);if(!id){id='device_'+Math.random().toString(36).slice(2)+'_'+Date.now().toString(36);localStorage.setItem(DEVICE_ID_KEY,id)}return id}
function migrateLocalBundles(){const a=load();let c=false;a.forEach(b=>{for(const[k,v]of Object.entries({serverVersion:0,serverSavedAt:null,dirty:true,syncConflict:false,remoteDeleted:false,sharedStatus:'ACTIVE'}))if(typeof b[k]==='undefined'){b[k]=v;c=true}});if(c)save(a)}
function createBundle(zoneName,spaceKey,teamName){const sp=spaces.find(x=>x.key===spaceKey),b={id:uuid(),zoneName,spaceKey,spaceName:sp?.displayName||'',createdAt:Date.now(),phase:'count1',ready:false,teamName:teamName.trim(),items:[],serverVersion:0,serverSavedAt:null,sharedStatus:'ACTIVE',dirty:true,syncConflict:false,remoteDeleted:false};const a=load();a.push(b);save(a);return b.id}
function setPhase(id,phase){mutate(id,b=>{b.phase=phase;if(phase!=='final')b.ready=false;b.dirty=true});renderBundleView()}function setReady(id,v){mutate(id,b=>{b.ready=!!v;b.dirty=true})}function setCount(id,rowNumber,field,value,itemRef){mutate(id,b=>{const it=b.items.find(x=>x.rowNumber===rowNumber&&x.label===itemRef.label&&x.dupNote===itemRef.dupNote);if(!it)return;it[field]=value===''?null:Number(value);if(field!=='final')b.ready=false;b.dirty=true});updateBundleSaveStatus()}function removeItemFromBundle(id,it){mutate(id,b=>{b.items=b.items.filter(x=>!(x.rowNumber===it.rowNumber&&x.label===it.label&&x.dupNote===it.dupNote));b.dirty=true})}
function populateZonesForSpace(){const sp=spaces.find(x=>x.key===$('newBundleSpace').value),z=$('newBundleZone');z.innerHTML='<option value="">Choisir une zone...</option>';(sp?.zones||[]).forEach(v=>z.add(new Option(v,v)));z.disabled=!(sp?.zones||[]).length}function loadSpaces(){google.script.run.withSuccessHandler(d=>{spaces=d?.spaces||[];const s=$('newBundleSpace');s.innerHTML='';spaces.forEach(x=>s.add(new Option(x.displayName,x.key)));s.onchange=populateZonesForSpace;populateZonesForSpace();renderBundles()}).withFailureHandler(e=>alert('Erreur espaces : '+(e?.message||e))).getZonesConfig()}
function checkConnectivity(timeoutMs=4000){return new Promise(resolve=>{if(!navigator.onLine)return resolve(false);let done=false,t=setTimeout(()=>{if(!done){done=true;resolve(false)}},timeoutMs);google.script.run.withSuccessHandler(()=>{if(!done){clearTimeout(t);done=true;resolve(true)}}).withFailureHandler(()=>{if(!done){clearTimeout(t);done=true;resolve(false)}}).ping()})}
async function deleteSharedUI(bundle,button){if(!Number(bundle.serverVersion||0)){if(confirm('Supprimer ce bundle ?')){deleteBundle(bundle.id);renderBundles()}return}if(!confirm('⚠️ Supprimer définitivement ce bundle ?'))return;if(!await checkConnectivity())return alert('📴 Connexion Internet nécessaire.');const old=button.textContent;button.disabled=true;button.textContent='⏳';google.script.run.withSuccessHandler(res=>{button.disabled=false;button.textContent=old;if(res?.conflict)return alert('⚠️ Version plus récente, actualise les bundles.');if(res?.approved)return alert('✅ Bundle déjà validé, suppression impossible.');if(!res?.ok)return alert('❌ Suppression impossible.');deleteBundle(bundle.id);currentBundleId===bundle.id?backToList():renderBundles()}).withFailureHandler(e=>{button.disabled=false;button.textContent=old;alert('❌ '+(e?.message||e))}).deleteSharedBundle({bundleId:bundle.id,serverVersion:Number(bundle.serverVersion||0),deviceId:getDeviceId()})}
function renderBundles(){const bs=load().sort((a,b)=>b.createdAt-a.createdAt),host=$('bundlesList');host.innerHTML='';$('listEmpty').style.display=bs.length?'none':'';bs.forEach(bundle=>{const row=document.createElement('div');row.className='bundle-item';if(bundle.phase==='final'&&bundle.ready){row.classList.add('bundle-ready')}const phase=bundle.phase==='count1'?['phase1','1er comptage']:bundle.phase==='count2'?['phase2','2e comptage']:['final','Synthèse'];row.innerHTML=`<div class="icon">📁</div><div class="body"><div class="title"></div><div class="badges"><span class="badge ${phase[0]}">${phase[1]}</span><span class="badge count">${(bundle.items||[]).length} article(s)</span></div><div class="meta"></div></div><div class="actions"></div>`;row.querySelector('.title').textContent=bundle.zoneName;row.querySelector('.meta').textContent=`${bundle.spaceName||'—'} • ${new Date(bundle.createdAt).toLocaleString()}`+(bundle.teamName?` • Équipe: ${bundle.teamName}`:'');const badges=row.querySelector('.badges'),add=(c,t)=>{const x=document.createElement('span');x.className='badge '+c;x.textContent=t;badges.append(x)};if(bundle.remoteDeleted)add('conflict','🗑️ Supprimé serveur');else if(bundle.syncConflict)add('conflict','⚠️ Conflit');else if(bundle.dirty)add('dirty','⚠️ Non sauvegardé');else if(bundle.serverVersion)add('cloud','☁️ Partagé');if(bundle.sharedStatus==='PENDING'||bundle.pendingAt)add('pending','En attente');if(bundle.ready&&bundle.phase==='final')add('ready','Prêt à l’export');const actions=row.querySelector('.actions'),mk=(t,h)=>{const b=document.createElement('button');b.className='secondary';b.textContent=t;b.onclick=h;return b},open=mk('📂 Ouvrir',()=>openBundle(bundle.id)),del=mk('🗑️',()=>deleteSharedUI(bundle,del)),send=mk('📤 Exporter',()=>sendOne(bundle)),stat=mk('🔄 Statut',()=>checkBundleStatus(bundle.id));send.disabled=!(bundle.phase==='final'&&bundle.ready)||bundle.dirty||bundle.pendingAt||bundle.sharedStatus==='PENDING';actions.append(open,del,send,stat);host.append(row)})}
function openBundle(id){currentBundleId=id;hide($('sectionList'));show($('sectionBundle'));show($('btnJumpToSearch'));renderBundleView()}function backToList(){currentBundleId=null;show($('sectionList'));hide($('sectionBundle'));hide($('btnJumpToSearch'));renderBundles()}function renderBundleView(){const b=getBundle(currentBundleId);if(!b)return backToList();$('bundleTitle').textContent='📁 '+b.zoneName;$('bundleMeta').textContent=`${b.spaceName||'—'}`+(b.teamName?` • Équipe: ${b.teamName}`:'')+` • ${b.items.length} article(s)`;renderBundleTable(b);renderFooter(b);updateBundleSaveStatus();hookBundleSearch()}
function updateBundleSaveStatus(){const b=getBundle(currentBundleId),s=$('bundleSaveStatus'),bt=$('btnSaveBundle');if(!b)return;if(b.remoteDeleted){s.textContent='🗑️ Supprimé serveur';bt.disabled=true;return}if(b.sharedStatus==='PENDING'){s.textContent='⏳ En attente';bt.disabled=true;return}bt.disabled=false;if(b.syncConflict){
  s.textContent='⚠️ Conflit';
  $('btnForceBundle').style.display = '';
  return;
}
$('btnForceBundle').style.display = 'none';if(b.dirty){s.textContent='⚠️ Modifications non sauvegardées';bt.classList.add('dirty');return}s.textContent=b.serverSavedAt?'☁️ Sauvegardé '+new Date(b.serverSavedAt).toLocaleString():'Sauvegarde serveur non effectuée';bt.classList.remove('dirty')}
function renderBundleTable(bundle){const wrap=$('bundleTableWrap');if(!bundle.items.length){wrap.innerHTML='<p class="muted">Ce bundle est vide.</p>';return}const fields=bundle.phase==='count1'?['1er comptage']:bundle.phase==='count2'?['2e comptage']:['1er','2e','Stock final'];wrap.innerHTML=`<table class="inventory-table"><thead><tr><th class="col-line">Ligne</th><th class="col-barcode">Code barre</th><th class="col-irec">Code IREC</th><th class="col-reference">Référence</th>${fields.map(x=>`<th class="col-count">${x}</th>`).join('')}${bundle.phase==='count1'?'<th class="col-remove">Retirer</th>':''}</tr></thead><tbody></tbody></table>`;const body=wrap.querySelector('tbody');[...bundle.items].sort((a,b)=>(b.addedAt||0)-(a.addedAt||0)).forEach(item=>{const row=document.createElement('tr');row.dataset.rowNumber=String(item.rowNumber);row.innerHTML='<td class="col-line"></td><td class="col-barcode"></td><td class="col-irec"></td><td class="col-reference ellipsis"></td>';row.children[0].textContent=item.rowNumber??'';row.children[1].textContent=item.codeBarre||'';row.children[2].textContent=item.codeIrec||'';row.children[3].textContent=(item.label||'')+(item.dupNote?` (${item.dupNote})`:'');const inp=(field,value)=>{const c=document.createElement('td');c.className='col-count';const i=document.createElement('input');i.className='qty';i.type='text';i.inputMode='none';i.readOnly=true;i.value=value??'';i.disabled=bundle.sharedStatus==='PENDING'||bundle.remoteDeleted;i.onclick=async()=>{if(i.disabled)return;highlightedRowNumber=Number(item.rowNumber);applyArticleHighlight();const orig=item[field]??'',q=await NumPad.open(orig,v=>i.value=v==null?'':String(v));if(q==null){i.value=orig;return}setCount(bundle.id,item.rowNumber,field,q,item);renderBundleView()};c.append(i);return c};if(bundle.phase==='count1'){row.append(inp('count1',item.count1));const c=document.createElement('td');c.className='col-remove';const b=document.createElement('button');b.className='secondary';b.textC