const NumPad=(()=>{let expression='',resolver=null,preview=null;const overlay=()=>$('numPadOverlay'),display=()=>$('numPadDisplay');function calc(v){const t=String(v||'').replace(/\s+/g,'');if(!t||!/^[0-9+\-*]+$/.test(t)||/^[+*]/.test(t)||/[+\-*]$/.test(t))return null;const tokens=t.match(/\d+|[+\-*]/g),p=[];let i=0;while(i<tokens.length){if(tokens[i]==='*'){if(!p.length||i+1>=tokens.length)return null;p.push(String(Number(p.pop())*Number(tokens[i+1])));i+=2}else p.push(tokens[i++])}let r=Number(p[0]);for(let j=1;j<p.length;j+=2){const n=Number(p[j+1]);if(p[j]==='+')r+=n;else if(p[j]==='-')r-=n;else return null}return Number.isFinite(r)&&r>=0?r:null}function update(){display().textContent=expression||'0';if(preview){if(!expression)return preview('');const c=calc(expression);if(c!=null)return preview(c);const p=calc(expression.replace(/[+\-*]+$/,''));preview(p!=null?p:'')}}function close(v){overlay().classList.remove('show');preview=null;if(resolver){const r=resolver;resolver=null;r(v)}}function validate(){const r=calc(expression);if(r==null)return;close(r)}function open(v='',cb=null){expression=v==null?'':String(v);if(expression==='0')expression='';preview=typeof cb==='function'?cb:null;update();overlay().classList.add('show');return new Promise(r=>resolver=r)}document.querySelectorAll('[data-num]').forEach(b=>b.onclick=()=>{expression+=b.dataset.num;update()});document.querySelectorAll('[data-op]').forEach(b=>b.onclick=()=>{if(!expression)return;const op=b.dataset.op,last=expression.slice(-1);expression=['+','-','*'].includes(last)?expression.slice(0,-1)+op:expression+op;update()});$('numPadBackspace').onclick=()=>{expression=expression.slice(0,-1);update()};$('numPadClear').onclick=()=>{expression='';update()};$('numPadValidate').onclick=validate;document.addEventListener('keydown',e=>{if(!overlay().classList.contains('show'))return;if(/^[0-9]$/.test(e.key)){e.preventDefault();expression+=e.key;update()}else if(['+','-','*'].includes(e.key)){e.preventDefault();con