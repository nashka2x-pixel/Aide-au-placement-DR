<div class="content">
<section id="sectionList">
<div class="card">
<div class="row">
<div>
<label>Espace</label>
<br>
<select id="newBundleSpace">
</select>
</div>
<div>
<label>Zone</label>
<br>
<select id="newBundleZone" disabled>
<option value="">Choisir une zone…</option>
</select>
</div>
<div>
<label>Nom d’équipe</label>
<br>
<input id="newTeamName" placeholder="Ex. Jean Michel">
</div>
<button id="btnCreate">Créer</button>
</div>
</div>
<div class="card row">
<span class="muted">N’exporte que les bundles prêts.</span>
<span class="spacer">
</span>
