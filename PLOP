async function bundleSearch(){const cb=$('s_cb').value.trim(),ir=$('s_irec').value.trim(),ti=$('s_int').value.trim(),out=$('bundleSearchResults'),msg=$('bundleSearchMsg');if(!cb&&!ir&&!ti){out.innerHTML='';msg.textContent='Saisis un code ou un intitulé.';return}msg.textContent='Recherche…';let results=[],local=await idbGetAll('catalog');if(local.length){if(ir)results=local.filter(x=>normIrc(x.codeIrec)===normIrc(ir));else if(cb){

