border-bottom:1px solid #efeff5;
font-size:14px;
vertical-align:middle;
text-align:left}
.inventory-table th {
background:#fafaff}
.inventory-table .col-line {
width:7%;
white-space:nowrap}
.inventory-table .col-barcode {
width:18%;
white-space:nowrap}
.inventory-table .col-irec {
width:15%;
white-space:nowrap}
.inventory-table .col-reference {
width:auto;
min-width:220px}
.inventory-table .col-count {
width:120px;
min-width:120px;
white-space:nowrap;
text-align:center}
.inventory-table .col-remove {
width:80px;
min-width:80px;
white-space:nowrap;
text-align:center}
.inventory-table .qty {
width:88px;
min-width:72px;
text-align:right}
.inventory-table .ellipsis {
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
max-width:1px}
.qty.warn-final {
