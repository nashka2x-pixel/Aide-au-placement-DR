const normTxt=s=>(s||'').toString().trim(),
      foldAcc=s=>normTxt(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''),
      foldForContains=s=>foldAcc(s).replace(/[^a-z0-9]+/g,' ').trim(),
      normIrc=s=>normTxt(s).toUpperCase().replace(/\s+|-/g,''),
      digits=s=>(s||'').toString().replace(/\D/g,'');

function barcodeMatch(catalogBarcode, scannedBarcode){
  const v = digits(catalogBarcode).replace(/^0+/,'');
  const q = digits(scannedBarcode).replace(/^0+/,'');

  if(!v || !q) return false;

  // Correspondance exacte
  if(v === q) return true;

  // Cas 12 ↔ 13 chiffres
  if(v.length === q.length + 1 && v.startsWith(q))
    return true;

  if(q.length === v.length + 1 && q.startsWith(v))
    return true;

  // Même code avec chiffre de contrôle différent
  if(
    v.length === q.length &&
    v.length >= 8 &&
    v.slice(0,-1) === q.slice(0,-1)
  ){
    return true;
  }

  return false;
}

